{
  "name": "screenkit",
  "version": "0.0.0",
  "private": true,
  "description": "ScreenKit: run an ordinary web build on TV hardware. This is the JavaScript half of the repo -- the runtime itself is C++ under runtime/.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "examples/*",
    "packages/@screenkit/*",
    "tools/dom-usage"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test --filter='./packages/**'",
    "lint": "turbo run lint",
    "dev": "turbo run dev",
    "package": "turbo run build:screenkit",
    "test:all": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.8.20"
  }
}
