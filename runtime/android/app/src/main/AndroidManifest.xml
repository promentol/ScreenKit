<?xml version="1.0" encoding="utf-8"?>
<!--
  ScreenKit on Android TV and Fire TV: one fullscreen, landscape activity in the
  Leanback launcher. It installs on any Android 7+ device (Leanback, a
  touchscreen and a gamepad are all optional) but is shaped for a TV remote.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <!--
      fetch, XMLHttpRequest, WebSocket, EventSource and network images, over the
      JNI client in runtime/core/src/net/NetServiceAndroid.cpp. The connections
      are OkHttp's, opened by dev.screenkit.net.HttpClient inside this process,
      so the app needs the permission itself.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Gamepad rumble (GamepadHapticActuator), through SDL. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Cleartext is allowed, and said so here rather than left to be inferred.
      The backend opens java.net.Socket directly, and a raw socket is not subject
      to NetworkSecurityPolicy at all; only the platform's own HTTP stacks
      consult it. So `http:` URLs work whatever this attribute says, and
      declaring false would be a claim the runtime does not enforce. The runtime
      supports plain HTTP by design (runtime/js/README.md, "Networking"); an
      embedder that wants it refused has to say so above the Connection seam.
    -->
    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:hardwareAccelerated="true"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <!--
          The attributes SDL's own template uses for SDLActivity: one instance,
          and the configuration changes SDL handles itself rather than letting
          Android recreate the activity. The list is wider than SDL's template:
          a recreated SDLActivity does not restart, it ends the process
          (SDLActivity.onCreate, "Activity already running, exiting"), so a
          display density, colour mode or input change would take the app down.
        -->
        <activity
            android:name=".ScreenKitActivity"
            android:alwaysRetainTaskState="true"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|density|colorMode|touchscreen|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleInstance"
            android:preferMinimalPostProcessing="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
